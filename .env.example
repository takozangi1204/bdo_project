# Django Core Settings
SECRET_KEY=your_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com,localhost,127.0.0.1

# Database URL (Provided by Render environment variables when using Neon PostgreSQL)
DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Email SMTP Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
REMINDER_RECIPIENT_EMAIL=recipient@example.com

# View/Edit Mode Toggle Password
APP_EDIT_PASSWORD=your_edit_password_here
