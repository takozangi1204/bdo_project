# Django Core Settings
SECRET_KEY=your_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
PYTHON_VERSION=3.12.8

# Database URL (Provided by Render environment variables when using Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Superuser Auto-Creation (For Render Free Tier)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=YourPassword123!
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Email SMTP Settings (For weekly reminder emails)
EMAIL_HOST=smtp-mail.outlook.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@outlook.com
EMAIL_HOST_PASSWORD=your_app_password_here
REMINDER_RECIPIENT_EMAIL=recipient@example.com

# View/Edit Mode Toggle Password
APP_EDIT_PASSWORD=112233zZ!!
